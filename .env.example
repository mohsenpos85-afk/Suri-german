# Copy this file to ".env.local" for local dev, and set the same two
# variables in your host's dashboard (Vercel/Netlify/Cloudflare) for deploy.
# These are the PUBLIC anon Supabase values — safe to expose in a browser
# build. Never put the Supabase "service_role" key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
